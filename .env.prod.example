# Environment for docker-compose.prod.yml
#
# Copy this file to .env.prod, fill in the real values, and pass it explicitly:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up --build -d
#
# .env.prod is untracked (.gitignore ignores .env.*). Never commit real
# credentials.

# --- Shared Postgres on the `proxy` network -----------------------------------
# Credentials for the existing shared database. The backend reaches it as host
# `postgres` on port 5432.
POSTGRES_DB=dinendash
POSTGRES_USER=dinendash
POSTGRES_PASSWORD=replace-with-a-strong-password

# --- JWT signing key ----------------------------------------------------------
# Becomes the API's Jwt:Key / Jwt__Key. Minimum 32 characters or the API
# refuses to start (see AuthenticationExtensions.AddJwtAuthentication).
# Generate one with: openssl rand -base64 48
JWT_KEY=replace-with-at-least-32-random-characters
